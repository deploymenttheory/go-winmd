# macOS
.DS_Store

# VSCode
.vs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Build and temp files
/build/
/tmp/
*.log
*.bak

# Windows-specific 
*.winfile eol=crlf

# Go development
# NB: no /pkg/ rule — that GOPATH-era build-output path is this module's
# source tree (pkg/winmd, pkg/nuget).
*.test
/vendor/
/bin/
/dist/
coverage.out
coverage.html

# Python virtual environments
scripts/python/venv/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
*.egg-info/

# AI instructions
.claude
.cursor

# Binaries and executables
*.dll
*.exe
*.dylib
*.so
# Test fixture (fetched on demand, pinned by testdata/PROVENANCE.json)
testdata/*.winmd

# golangci-lint SARIF output (see .golangci.yml output settings)
golangci-lint-report.sarif
